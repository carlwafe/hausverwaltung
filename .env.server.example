# Vorlage für die Datei `.env` auf dem Mini-PC (neben docker-compose.yml). Anleitung: docs/mini-pc.md
# Passwort/Secret erzeugen: openssl rand -hex 24   bzw.   openssl rand -base64 32
POSTGRES_PASSWORD=
NEXTAUTH_URL=https://<deine-domain>
NEXTAUTH_SECRET=
TUNNEL_TOKEN=
# Optional: KI-Prüfung im Kontoauszug-Import
ANTHROPIC_API_KEY=
# Wird beim Update gesetzt: export APP_VERSION=$(git rev-parse --short HEAD)
APP_VERSION=
