# Vercel Postgres / Neon — wird bei "Connect Store" automatisch als Projekt-Env-Var gesetzt.
DATABASE_URL=

# NextAuth
NEXTAUTH_URL=https://<deine-domain>.vercel.app
# Zufälliges Secret erzeugen: openssl rand -base64 32
NEXTAUTH_SECRET=

# Vercel Blob (privater Store) — auf Vercel selbst automatisch über OIDC verbunden, kein Token
# nötig. Nur für lokale Entwicklung erforderlich: `vercel env pull` ausführen, dann landet
# BLOB_READ_WRITE_TOKEN automatisch in .env.local.
BLOB_READ_WRITE_TOKEN=
