// Prisma schema — Buchhaltungs-App Mietobjekt Eutin
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GAST
}

enum EinheitTyp {
  WOHNUNG
  GARAGE
}

enum MietvertragStatus {
  AKTIV
  BEENDET
  GEPLANT
}

enum Verteilerschluessel {
  WOHNFLAECHE
  MITEIGENTUMSANTEIL
  PERSONENZAHL
  EINHEITEN
  VERBRAUCH_MANUELL
  // Extern vorverteilt (z.B. Heizkosten, für die Techem bereits eine fertige Aufschlüsselung
  // pro Wohnung liefert) — wird von der Nebenkostenabrechnung-Engine bewusst nie selbst
  // berechnet, die tatsächliche Pro-Mieter-Aufteilung kommt aus einer separaten Quelle.
  VORVERTEILT
}

enum KautionAnlageform {
  SPARBUCH
  KAUTIONSKONTO
  BUERGSCHAFT
  BAR
}

enum KautionStatus {
  AKTIV
  // Das Kautionskonto wurde aufgelöst (z.B. per Überweisung auf das normale Konto), aber der
  // Betrag noch nicht (vollständig) an den Mieter ausgezahlt — Zwischenschritt, damit ein
  // einbehaltener Anteil später aus Auflösungs- ./. Rückzahlungsbetrag berechnet werden kann.
  AUFGELOEST
  ZURUECKGEZAHLT
}

enum AbrechnungStatus {
  ENTWURF
  FINAL
}

enum Kontokreis {
  MIETKONTO
  KAUTIONSKONTO
  OBJEKTKONTO
}

// Kleine, gepflegte Stammdaten-Tabelle statt Enum im Code — neue Buchungsarten kommen im Betrieb
// dazu, ohne dass deploy't werden muss. Zwei unabhängige Flags: zahlungswirksam (fließt echtes
// Geld übers Konto? steuert /kontostand) und eurRelevant (zählt für die steuerliche EÜR? steuert
// Jahresübersicht). Kaution ist der Grund, warum beide getrennt sein müssen: zahlungswirksam =
// wahr, aber eurRelevant = falsch (erfolgsneutraler Durchlaufposten).
model Buchungsart {
  id              String     @id @default(cuid())
  code            String     @unique
  bezeichnung     String
  kontokreis      Kontokreis
  zahlungswirksam Boolean
  eurRelevant     Boolean
  aktiv           Boolean    @default(true)
  createdAt       DateTime   @default(now())

  buchungen Buchung[]

  @@map("buchungsarten")
}

// Das Journal: jede Geldbewegung/Sollstellung als unveränderliche Zeile. Ersetzt Zahlung,
// Kostenposition, KautionBuchung, EigentuemerBuchung und NebenkostenausgleichZahlung aus dem
// Vorgänger-Modell — siehe Vergleichsplan. Saldo/Reports sind nie ein gespeicherter Wert, sondern
// immer eine Abfrage auf diese Tabelle (siehe src/lib/buchungsjournal.ts).
//
// Bewusster Kompromiss gegenüber getrennten Tabellen: mehrere Domänenfelder (kostenartId,
// gebaeudeId/hausId/kostengruppeId/einheitId, periodeMonat/periodeJahr, jahr) sind
// nur bei bestimmten Buchungsarten sinnvoll befüllt — die Schema-Ebene erzwingt das nicht mehr
// (anders als z.B. Kostenposition.kostenartId, das vorher ein Pflicht-Feld war). Das ist genau
// der Typsicherheits-Preis des Journal-Modells, siehe Gegenüberstellung im Chat.
model Buchung {
  id            String       @id @default(cuid())
  mietvertrag   Mietvertrag? @relation(fields: [mietvertragId], references: [id], onDelete: SetNull)
  mietvertragId String?
  buchungsart   Buchungsart  @relation(fields: [buchungsartId], references: [id], onDelete: Restrict)
  buchungsartId String
  // Nullable: eine manuell erfasste, umlagefähige Kostenposition kennt teils nur das Jahr, kein
  // genaues Buchungsdatum (siehe jahr unten) — Berichte, die einen echten Zeitpunkt brauchen
  // (Kontostand-Verlauf), filtern dann bewusst auf datum != null, wie im Vorgänger-Modell.
  datum         DateTime?
  betrag        Decimal      @db.Decimal(10, 2)

  // Nur bei KOSTENPOSITION-artigen Buchungen gesetzt (Zuordnung zur Kostenart/Gebäude-Ebene) —
  // höchstens eins von gebaeude/haus/kostengruppe/einheit, wie im Vorgänger-Modell.
  kostenart      Kostenart?    @relation(fields: [kostenartId], references: [id], onDelete: Restrict)
  kostenartId    String?
  gebaeude       Gebaeude?     @relation(fields: [gebaeudeId], references: [id], onDelete: SetNull)
  gebaeudeId     String?
  haus           Haus?         @relation(fields: [hausId], references: [id], onDelete: SetNull)
  hausId         String?
  kostengruppe   Kostengruppe? @relation(fields: [kostengruppeId], references: [id], onDelete: SetNull)
  kostengruppeId String?
  einheit        Einheit?      @relation(fields: [einheitId], references: [id], onDelete: SetNull)
  einheitId      String?

  // Nur bei MIETZAHLUNG gesetzt: für welchen Monat diese Zahlung gedacht ist (nicht wann sie
  // einging) — siehe periodeMonat/periodeJahr im Vorgänger-Modell.
  periodeMonat Int?
  periodeJahr  Int?
  // Doppelt genutzt, je nach Buchungsart (nie gleichzeitig): bei KOSTENPOSITION das Kostenjahr
  // (immer gesetzt, auch ohne genaues datum), bei NEBENKOSTENAUSGLEICH das Abrechnungsjahr, auf
  // das sich die Rückzahlung/Nachzahlung bezieht (optional).
  jahr         Int?

  empfaenger       String?
  verwendungszweck String?
  bemerkung        String?

  // Polymorpher Bezug auf das auslösende Ereignis (z.B. "NebenkostenabrechnungPosition") — ersetzt
  // die vorher typisierte virtuelleKautionBuchungId-Relation; büßt dafür referenzielle Integrität
  // auf DB-Ebene ein (Postgres kann bezugId nicht als echten FK prüfen).
  bezugTyp String?
  bezugId  String?

  rohdaten           Json?
  importBatch        ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importBatchId      String?
  aufteilungGruppeId String?

  erstelltAm  DateTime @default(now())
  erstelltVon String?

  // Storno-Prinzip: kein UPDATE/DELETE aus der Anwendung heraus, nur eine Gegenbuchung mit
  // negiertem Betrag, die hierher zurückverweist.
  storniertDurchBuchungId String?  @unique
  storniertDurch          Buchung? @relation("Storno", fields: [storniertDurchBuchungId], references: [id])
  storniertZeile          Buchung? @relation("Storno")

  dokumente        Dokument[]
  kautionEinbehalt KautionEinbehalt?

  @@index([mietvertragId, datum])
  @@index([buchungsartId])
  @@index([kostenartId])
  @@index([aufteilungGruppeId])
  @@map("buchungen")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  passwordHash  String
  role          Role          @default(GAST)
  createdAt     DateTime      @default(now())
  importBatches ImportBatch[]

  @@map("users")
}

model Objekt {
  id                    String    @id @default(cuid())
  name                  String
  strasse               String
  hausnummer            String
  plz                   String
  ort                   String    @default("Eutin")
  beschreibung          String?
  // Stichtag, ab dem Soll/Ist-Vergleiche gerechnet werden (z.B. weil ältere Kontoauszüge
  // nicht mehr vorliegen). Ist er gesetzt, läuft die Soll-Berechnung erst ab max(Mietbeginn,
  // buchhaltungAb) statt seit dem tatsächlichen (evtl. jahrzehntealten) Mietbeginn.
  buchhaltungAb         DateTime?
  // Gespeicherter Stichtag für die Offene-Posten-Ansicht ("Buchhaltung erfasst bis") — null
  // bedeutet "heute", wird also bei jedem Aufruf automatisch aktuell gehalten. Bewusst
  // persistiert statt nur als URL-Parameter geführt, damit ein einmal gewählter Stichtag auch
  // nach dem Verlassen der Seite erhalten bleibt, bis er explizit gespeichert oder
  // zurückgesetzt wird.
  buchhaltungBis        DateTime?
  // Referenzpunkt für die simulierte Kontostand-Ansicht: der reale, z.B. von einem
  // Kontoauszug abgelesene Kontostand an einem bestimmten Tag. Die Bank-CSV-Exporte führen
  // selbst keine laufende Saldo-Spalte, daher lässt sich der Kontostand nur relativ zu diesem
  // Anker aus der Summe aller erfassten Buchungen (Zahlungen, Kosten, Mietweiterleitungen,
  // Kautionsbuchungen, sonstige Buchungen) rekonstruieren, nicht absolut.
  kontostandAnkerDatum  DateTime?
  kontostandAnkerBetrag Decimal?  @db.Decimal(10, 2)
  createdAt             DateTime  @default(now())

  gebaeude      Gebaeude[]
  haeuser       Haus[]
  kostengruppen Kostengruppe[]

  @@map("objekte")
}

// Ein physisches Bauwerk, falls mehrere Hausnummern zum selben Gebäude gehören (z.B. Breslauer
// Str. 2, 4 und 6 sind ein Bauwerk mit drei Hausnummern). Eigene Identität getrennt von Gebaeude,
// damit eine Kostenposition eindeutig entweder einer einzelnen Adresse (z.B. eine Reparatur) oder
// dem ganzen Haus (z.B. Grundsteuer, die pro Bauwerk statt pro Adresse abgerechnet wird) zugeordnet
// werden kann — mit nur einer wiederverwendeten Gebäude-ID für beides wäre das nicht
// unterscheidbar.
model Haus {
  id        String   @id @default(cuid())
  objekt    Objekt   @relation(fields: [objektId], references: [id], onDelete: Cascade)
  objektId  String
  createdAt DateTime @default(now())

  gebaeude  Gebaeude[]
  buchungen Buchung[]

  @@map("haeuser")
}

// Eine frei benannte Gruppe aus mehreren Gebäuden, unabhängig von der physischen Haus-Zuordnung
// — z.B. wenn ein Versorger (Techem) mehrere Häuser gemeinsam abrechnet, die keine gemeinsame
// physische Einheit sind (anders als Haus, das genau ein Bauwerk meint). Ein Gebäude kann in
// mehreren Kostengruppen gleichzeitig stecken (many-to-many), anders als bei Haus (dort höchstens
// eine Zuordnung).
model Kostengruppe {
  id          String   @id @default(cuid())
  objekt      Objekt   @relation(fields: [objektId], references: [id], onDelete: Cascade)
  objektId    String
  bezeichnung String
  createdAt   DateTime @default(now())

  gebaeude  Gebaeude[]
  buchungen Buchung[]

  @@map("kostengruppen")
}

// Eine Hausnummer (eigene Betriebskosten-/Zähler-Einheit für die Nebenkostenabrechnung).
model Gebaeude {
  id            String         @id @default(cuid())
  objekt        Objekt         @relation(fields: [objektId], references: [id], onDelete: Cascade)
  objektId      String
  strasse       String
  hausnummer    String
  // Physisches Gebäude, falls mehrere Hausnummern zum selben Bauwerk gehören.
  haus          Haus?          @relation(fields: [hausId], references: [id], onDelete: SetNull)
  hausId        String?
  kostengruppen Kostengruppe[]
  beschreibung  String?
  createdAt     DateTime       @default(now())

  einheiten Einheit[]
  buchungen Buchung[]

  @@unique([objektId, strasse, hausnummer])
  @@map("gebaeude")
}

model Einheit {
  id             String     @id @default(cuid())
  gebaeude       Gebaeude   @relation(fields: [gebaeudeId], references: [id], onDelete: Restrict)
  gebaeudeId     String
  bezeichnung    String
  typ            EinheitTyp @default(WOHNUNG)
  etage          String?
  wohnflaecheQm  Decimal    @db.Decimal(8, 2)
  einbaukueche   Boolean    @default(false)
  fotosVorhanden Boolean    @default(false)
  notizen        String?
  createdAt      DateTime   @default(now())

  mietvertraege                   Mietvertrag[]
  nebenkostenabrechnungPositionen NebenkostenabrechnungPosition[]
  verbrauchswerte                 Verbrauchswert[]
  dokumente                       Dokument[]
  buchungen                       Buchung[]

  @@unique([gebaeudeId, bezeichnung])
  @@map("einheiten")
}

model Mieter {
  id                    String   @id @default(cuid())
  vorname               String
  nachname              String
  email                 String?
  handynummer           String?
  festnetznummer        String?
  // Rein informativ, um nachzuvollziehen, dass die Miete (teilweise) direkt vom Jobcenter
  // gezahlt wird, statt fälschlich als Zahlungsverzug zu erscheinen — keine Wertung.
  buergergeldEmpfaenger Boolean  @default(false)
  notizen               String?
  createdAt             DateTime @default(now())

  mietvertraege Mietvertrag[]

  @@map("mieter")
}

model Mietvertrag {
  id                       String            @id @default(cuid())
  einheit                  Einheit           @relation(fields: [einheitId], references: [id], onDelete: Restrict)
  einheitId                String
  mieter                   Mieter[]
  // Optional statt Pflichtfeld: bei manchen längst ausgezogenen Mietern (Vertragsende weit in
  // der Vergangenheit) ist das ursprüngliche Einzugsdatum nicht mehr bekannt und für Soll/Ist
  // oder eine Nebenkostenabrechnung auch nicht mehr relevant — null bedeutet "unbekannt", nicht
  // "vor Beginn der Zeit". Soll-Berechnung und Nebenkostenabrechnung behandeln ein unbekanntes
  // beginn wie einen beliebig weit in der Vergangenheit liegenden Termin (siehe soll-ist.ts,
  // nebenkostenabrechnung.ts).
  beginn                   DateTime?
  ende                     DateTime?
  kaltmiete                Decimal           @db.Decimal(10, 2)
  nebenkostenVorauszahlung Decimal           @db.Decimal(10, 2)
  // Nur bei Garagen/Stellplätzen relevant: diese werden umsatzsteuerpflichtig vermietet
  // (anders als Wohnraum, der nach §4 Nr. 12 UStG umsatzsteuerfrei ist) und haben daher keine
  // Nebenkosten, aber eine Mehrwertsteuer-Vorauszahlung.
  mehrwertsteuer           Decimal?          @db.Decimal(10, 2)
  status                   MietvertragStatus @default(AKTIV)
  // Endsaldo aus der Zeit vor `Objekt.buchhaltungAb` (z.B. aus einem extern — außerhalb dieser
  // App — abgeschlossenen Jahresbericht/einer Nebenkostenabrechnung für ein Jahr, das hier nie
  // erfasst wurde). Fließt als fixer Startwert in die Offene-Posten-Berechnung ein (saldo = ist -
  // soll + saldovortrag), ohne dass das betreffende Altjahr selbst nachgebildet werden muss.
  // Negativ = Rückstand, positiv = Guthaben — gleiche Vorzeichenlogik wie der Saldo selbst.
  saldovortrag             Decimal           @default(0) @db.Decimal(10, 2)
  createdAt                DateTime          @default(now())

  kaution                           Kaution?
  buchungen                         Buchung[]
  dokumente                         Dokument[]
  abrechnungspositionen             NebenkostenabrechnungPosition[]
  vorverteilteKostenanteile         VorverteilterKostenanteil[]
  jahresberichtVerifikationen       JahresberichtVerifikation[]
  mieterhoehungen                   Mieterhoehung[]
  mieterhoehungVorschlaegeVerworfen MieterhoehungVorschlagVerworfen[]

  @@map("mietvertraege")
}

// Eine Mieterhöhung ab einem bestimmten Monat — der Mietvertrag selbst behält seine kaltmiete/
// nebenkostenVorauszahlung als Basiswert (ab Mietbeginn bzw. Buchhaltungs-Stichtag), jede
// Mieterhoehung überschreibt diesen Wert ab ihrem gueltigAb-Monat, bis zur nächsten (falls
// vorhanden) — siehe ermittleMieteFuerMonat/ermittleAktuelleMiete in src/lib/soll-ist.ts.
model Mieterhoehung {
  id                       String      @id @default(cuid())
  mietvertrag              Mietvertrag @relation(fields: [mietvertragId], references: [id], onDelete: Cascade)
  mietvertragId            String
  // Ab diesem Monat gilt die neue Miete (Tag wird ignoriert, es zählt der Kalendermonat — wie bei
  // sollAufschluesselung, wo ein angebrochener Monat schon ab seinem 1. Tag voll zählt).
  gueltigAb                DateTime
  kaltmiete                Decimal     @db.Decimal(10, 2)
  nebenkostenVorauszahlung Decimal     @db.Decimal(10, 2)
  notizen                  String?
  createdAt                DateTime    @default(now())

  @@unique([mietvertragId, gueltigAb])
  @@map("mieterhoehungen")
}

// Nutzer hat einen automatisch aus der Zahlungshistorie erkannten Mieterhöhungs-Vorschlag
// (src/lib/mieterhoehung-erkennung.ts) explizit abgelehnt — reine Existenz der Zeile = verworfen
// (kein Boolean-Feld nötig), analog zu JahresberichtVerifikation. Anders als ein einfacher Reload
// soll das dauerhaft gelten, bis der Nutzer es über denselben Toggle wieder rückgängig macht.
model MieterhoehungVorschlagVerworfen {
  id            String      @id @default(cuid())
  mietvertrag   Mietvertrag @relation(fields: [mietvertragId], references: [id], onDelete: Cascade)
  mietvertragId String
  abJahr        Int
  abMonat       Int
  erstelltAm    DateTime    @default(now())

  @@unique([mietvertragId, abJahr, abMonat])
  @@map("mieterhoehung_vorschlaege_verworfen")
}

model Kaution {
  id                  String            @id @default(cuid())
  mietvertrag         Mietvertrag       @relation(fields: [mietvertragId], references: [id], onDelete: Cascade)
  mietvertragId       String            @unique
  betrag              Decimal           @db.Decimal(10, 2)
  anlageform          KautionAnlageform @default(KAUTIONSKONTO)
  zinssatz            Decimal?          @db.Decimal(5, 2)
  einzahlungsdatum    DateTime?
  // Wann/mit welchem Betrag das Kautionskonto aufgelöst wurde (Status AUFGELOEST) — meist eine
  // Überweisung des vollen hinterlegten Betrags auf das normale Konto, von dort ggf. erst später
  // (teilweise) an den Mieter ausgezahlt. Optional: nicht jede Kaution läuft über ein separates
  // Kautionskonto, manche werden direkt aus betrag heraus ausgezahlt (Status AKTIV -> ZURUECKGEZAHLT).
  aufloesungsdatum    DateTime?
  aufloesungsbetrag   Decimal?          @db.Decimal(10, 2)
  // Die tatsächlich an den Mieter ausgezahlte Rückzahlung — kann kleiner als aufloesungsbetrag
  // (bzw. betrag, falls nie aufgelöst) sein, wenn ein Teil einbehalten wurde. Die Differenz ist
  // der "einbehaltene" Betrag, siehe kaution.ts.
  rueckzahlungsdatum  DateTime?
  rueckzahlungsbetrag Decimal?          @db.Decimal(10, 2)
  status              KautionStatus     @default(AKTIV)
  // Freitext für Fälle, die aus den Kontobewegungen allein nicht rekonstruierbar sind — z.B.
  // wenn beim Auszug intern auf dem Kautionskonto ein Teilbetrag für eine Reparatur einbehalten
  // wurde, was in unseren Kontoauszügen nirgends als eigene Buchung erscheint.
  notizen             String?
  createdAt           DateTime          @default(now())

  einbehalte KautionEinbehalt[]

  @@map("kautionen")
}

enum KautionEinbehaltStatus {
  // Unbestritten, sofort wirksam — zählt direkt in die "Einbehalten"-Summe auf /kautionen.
  UNSTRITTIG
  // Noch nicht geklärt — das Zurückbehaltungsrecht gilt: die Anwendung darf diesen Betrag noch
  // nicht als endgültig einbehalten ausweisen, er bleibt als offener Fall sichtbar.
  STRITTIG_OFFEN
  STRITTIG_BESTAETIGT
  STRITTIG_VERWORFEN
}

// Ein einzelner, begründeter Einbehalt bei Auflösung der Kaution (z.B. Schadensersatz, offene
// NK-Nachzahlung) — löst das Problem, dass die bisherige "Einbehalten"-Zahl (Auflösung ./.
// Auszahlung) nur eine unerklärte Differenz war, ohne Angabe wofür und ohne Streit-Status.
model KautionEinbehalt {
  id                String                 @id @default(cuid())
  kaution           Kaution                @relation(fields: [kautionId], references: [id], onDelete: Cascade)
  kautionId         String
  positionText      String
  betrag            Decimal                @db.Decimal(10, 2)
  // Optionaler Bezug, z.B. auf eine offene NebenkostenabrechnungPosition.
  bezugTyp          String?
  bezugId           String?
  status            KautionEinbehaltStatus @default(STRITTIG_OFFEN)
  belegId           String?
  erstelltAm        DateTime               @default(now())
  statusGeaendertAm DateTime               @default(now())
  // Gesetzt, sobald status UNSTRITTIG/STRITTIG_BESTAETIGT erreicht und dafür eine echte
  // KAUTION_EINBEHALT-Buchung im Journal entstanden ist (siehe kautionen/actions.ts) — null,
  // solange der Einbehalt strittig offen ist (Zurückbehaltungsrecht: kein Buchungssatz, bevor der
  // Streit geklärt ist). Wechselt der Status zurück auf offen/verworfen, wird die Buchung
  // storniert und dieser Verweis wieder auf null gesetzt.
  buchung           Buchung?               @relation(fields: [buchungId], references: [id], onDelete: SetNull)
  buchungId         String?                @unique

  @@index([kautionId])
  @@map("kaution_einbehalte")
}

model Kostenart {
  id                          String               @id @default(cuid())
  name                        String               @unique
  umlagefaehig                Boolean              @default(true)
  standardVerteilerschluessel Verteilerschluessel?
  // Nur relevant bei Verteilerschlüssel VERBRAUCH_MANUELL, z.B. "kWh" oder "m³" — Beschriftung
  // für die Verbrauchswert-Erfassung und die Abrechnungsanzeige.
  masseinheit                 String?
  // Welche der 16 namentlich benannten BetrKV-Kategorien diese Kostenart abdeckt (1 Grundsteuer/
  // öffentl. Lasten, 2 Wasserversorgung, 3 Entwässerung, 4 Heizung, 5 Warmwasser, 6 verbundene
  // Heizung+Warmwasser, 7 Aufzug, 8 Straßenreinigung/Müllbeseitigung, 9 Gebäudereinigung/
  // Ungezieferbekämpfung, 10 Gartenpflege, 11 Beleuchtung, 12 Schornsteinreinigung, 13 Sach-/
  // Haftpflichtversicherung, 14 Hauswart, 15 Antenne/Kabelanschluss, 16 Wäschepflege) — rein
  // dokumentarisch, keine Berechnung hängt daran. Nr. 17 ("sonstige") wird bewusst NICHT hier
  // eingetragen, sondern über istSonstigeBetriebskosten/vertraglicheGrundlage unten, weil dafür
  // zusätzlich ein Pflichtnachweis nötig ist.
  betrKvNummer                 Int?
  // true = fällt unter § 2 Nr. 17 BetrKV ("sonstige Betriebskosten", z.B. Rauchwarnmelder-Wartung,
  // Dachrinnenreinigung) statt einer der namentlich benannten Nr. 1–16. Laut BGH-Rechtsprechung
  // reicht dafür ein pauschaler Verweis auf § 2 Nr. 17 BetrKV im Mietvertrag NICHT aus — jede
  // einzelne Position muss dort konkret benannt sein, sonst ist die Umlage angreifbar.
  istSonstigeBetriebskosten   Boolean              @default(false)
  // Pflicht, wenn istSonstigeBetriebskosten und umlagefaehig beide true sind: Fundstelle/Wortlaut
  // aus dem Mietvertrag, der diese konkrete Kostenposition benennt (siehe Kommentar oben).
  vertraglicheGrundlage       String?
  createdAt                   DateTime             @default(now())

  buchungen                 Buchung[]
  verbrauchswerte           Verbrauchswert[]
  vorverteilteKostenanteile VorverteilterKostenanteil[]

  @@map("kostenarten")
}

// Ein Ablesewert (z.B. Zählerstand-Differenz) pro Einheit, Kostenart und Jahr — Grundlage für die
// Verteilung von Kostenarten mit Verteilerschlüssel VERBRAUCH_MANUELL in der
// Nebenkostenabrechnung. Fehlt für eine Einheit im betroffenen Kostenpool der Wert für ein Jahr,
// wird die ganze Kostenart für dieses Jahr bewusst nicht berechnet (siehe
// src/lib/nebenkostenabrechnung.ts) statt die fehlende Einheit stillschweigend zu übergehen.
model Verbrauchswert {
  id             String    @id @default(cuid())
  einheit        Einheit   @relation(fields: [einheitId], references: [id], onDelete: Cascade)
  einheitId      String
  kostenart      Kostenart @relation(fields: [kostenartId], references: [id], onDelete: Cascade)
  kostenartId    String
  jahr           Int
  wert           Decimal   @db.Decimal(12, 3)
  notizen        String?
  createdAt      DateTime  @default(now())
  aktualisiertAm DateTime  @updatedAt

  @@unique([einheitId, kostenartId, jahr])
  @@map("verbrauchswerte")
}

// Der tatsächliche, extern (z.B. von Techem) schon korrekt pro Mieter berechnete Anteil einer
// Kostenart mit Verteilerschlüssel VORVERTEILT (siehe Kommentar dort) — die Engine berechnet
// diese Kostenart nie selbst (siehe src/lib/nebenkostenabrechnung.ts), sondern addiert stattdessen
// den hier erfassten Betrag auf die passende NebenkostenabrechnungPosition. Pro Mietvertrag statt
// pro Einheit (wie Verbrauchswert), weil z.B. Techem bei einem unterjährigen Mieterwechsel selbst
// schon pro Nutzungszeitraum aufteilt — entspricht 1:1 unserem eigenen Modell "eine Position pro
// Mietvertrag/Zeitraum". Bewusst unabhängig vom NebenkostenabrechnungPosition-Lebenszyklus (wird
// bei einem "Neu berechnen" nicht gelöscht), damit der eingetragene Wert erhalten bleibt.
model VorverteilterKostenanteil {
  id             String      @id @default(cuid())
  mietvertrag    Mietvertrag @relation(fields: [mietvertragId], references: [id], onDelete: Cascade)
  mietvertragId  String
  kostenart      Kostenart   @relation(fields: [kostenartId], references: [id], onDelete: Cascade)
  kostenartId    String
  jahr           Int
  betrag         Decimal     @db.Decimal(10, 2)
  notizen        String?
  createdAt      DateTime    @default(now())
  aktualisiertAm DateTime    @updatedAt

  @@unique([mietvertragId, kostenartId, jahr])
  @@map("vorverteilte_kostenanteile")
}

// Manuelle Markierung auf der Jahresübersicht: der Nutzer hat "Saldo neu" für diesen
// Mietvertrag/dieses Jahr mit dem vorhandenen (externen, vom früheren Verwalter erstellten)
// Jahresbericht abgeglichen und für übereinstimmend befunden. Reine Existenz der Zeile = markiert
// (kein Boolean-Feld nötig) — bleibt bestehen, bis der Nutzer sie explizit wieder entfernt, auch
// wenn sich die Berechnung durch spätere Datenänderungen ändert (bewusst keine automatische
// Entfernung, da sonst jede Nachimport-Korrektur eine bereits geprüfte Markierung stillschweigend
// löschen würde).
model JahresberichtVerifikation {
  id            String      @id @default(cuid())
  mietvertrag   Mietvertrag @relation(fields: [mietvertragId], references: [id], onDelete: Cascade)
  mietvertragId String
  jahr          Int
  erstelltAm    DateTime    @default(now())

  @@unique([mietvertragId, jahr])
  @@map("jahresbericht_verifikationen")
}

// Der manuell vom echten Kontoauszug abgelesene Kontostand zum 31.12. eines Jahres — die externe
// Gegenprüfung zum Kontenabgleich auf jahresuebersicht/page.tsx (siehe kontostandAmStichtag): der
// dort berechnete Kontostand ist nur intern konsistent (rechnet sich selbst nach), dieser Wert
// hier ist der einzige Bezug zur Realität, ohne den eine Abweichung nie auffallen würde.
model KontenabgleichVerifikation {
  id                       String   @id @default(cuid())
  jahr                     Int      @unique
  kontostandLautBankauszug Decimal  @db.Decimal(10, 2)
  erstelltAm               DateTime @default(now())
  aktualisiertAm           DateTime @updatedAt

  @@map("kontenabgleich_verifikationen")
}

// Eine Abrechnung pro Jahr fürs ganze Objekt (nicht pro Gebäude) — Kosten liegen inzwischen auf
// drei Ebenen (Objekt gesamt, Haus, einzelnes Gebäude), eine Abrechnung pro Gebäude müsste die
// anteilig wieder zusammenrechnen. Die Berechnung selbst ordnet jeder Einheit intern korrekt zu,
// welche Kosten sie betreffen (siehe src/lib/nebenkostenabrechnung.ts).
model Nebenkostenabrechnung {
  id         String           @id @default(cuid())
  jahr       Int              @unique
  status     AbrechnungStatus @default(ENTWURF)
  erstelltAm DateTime         @default(now())

  positionen NebenkostenabrechnungPosition[]

  @@map("nebenkostenabrechnungen")
}

model NebenkostenabrechnungPosition {
  id                  String                @id @default(cuid())
  abrechnung          Nebenkostenabrechnung @relation(fields: [abrechnungId], references: [id], onDelete: Cascade)
  abrechnungId        String
  einheit             Einheit               @relation(fields: [einheitId], references: [id], onDelete: Restrict)
  einheitId           String
  mietvertrag         Mietvertrag?          @relation(fields: [mietvertragId], references: [id], onDelete: SetNull)
  mietvertragId       String?
  // Der von diesem Mietvertrag tatsächlich abgedeckte Zeitraum innerhalb des Abrechnungsjahres
  // (z.B. bei einem Mieterwechsel am 1.7. nur 6 von 12 Monaten) — mehrere Positionen pro Einheit
  // möglich, je eine pro Mietvertrag, der die Einheit in diesem Jahr zeitweise innehatte.
  zeitraumVon         DateTime
  zeitraumBis         DateTime
  kostenanteilGesamt  Decimal               @db.Decimal(10, 2)
  vorauszahlungGesamt Decimal               @db.Decimal(10, 2)
  // positiv = Guthaben (Vorauszahlung > Kostenanteil), negativ = Nachzahlung fällig.
  saldo               Decimal               @db.Decimal(10, 2)
  details             Json?

  @@unique([abrechnungId, einheitId, mietvertragId])
  @@map("nebenkostenabrechnung_positionen")
}

model Dokument {
  id             String       @id @default(cuid())
  dateiname      String
  speicherpfad   String
  mimeType       String?
  groesseBytes   Int?
  mietvertrag    Mietvertrag? @relation(fields: [mietvertragId], references: [id], onDelete: Cascade)
  mietvertragId  String?
  buchung        Buchung?     @relation(fields: [buchungId], references: [id], onDelete: Cascade)
  buchungId      String?
  // Fotos einer Einheit (Zustand, Ausstattung) — dieselbe Ablage wie Mietvertrags-/Kosten-Belege,
  // nur mit einem dritten möglichen Ziel.
  einheit        Einheit?     @relation(fields: [einheitId], references: [id], onDelete: Cascade)
  einheitId      String?
  hochgeladenVon String?
  // Datum des Belegs selbst (z.B. Rechnungs-/Vertragsdatum) — vom Nutzer beim Upload angegeben und
  // später änderbar. createdAt bleibt das Upload-Datum. Die Belege-Tabelle sortiert nach
  // belegDatum (fehlt es: nach dem Upload-Datum), neueste zuerst.
  belegDatum     DateTime?
  createdAt      DateTime     @default(now())

  @@map("dokumente")
}

model ImportBatch {
  id           String   @id @default(cuid())
  typ          String
  dateiname    String
  // Pfad der gespeicherten Originaldatei im lokalen Storage (siehe src/lib/storage.ts) — damit
  // man vom Import zurück zur tatsächlich hochgeladenen Quelldatei kann. Nicht jeder Import-Typ
  // speichert die Datei (noch), daher optional.
  speicherpfad String?
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  ergebnis     String?
  anzahlZeilen Int?
  erstelltAm   DateTime @default(now())

  buchungen                 Buchung[]
  nichtZugeordneteBuchungen NichtZugeordneteBuchung[]

  @@map("import_batches")
}

// Eine beim Kontoauszug-Import bewusst noch nicht zugeordnete Buchung — der Nutzer konnte sie in
// keiner der 5 Import-Sektionen sofort klar zuordnen (kein passender Mietvertrag/keine passende
// Kostenart erkennbar) und hat sie stattdessen explizit "als nicht kategorisiert importieren"
// markiert, statt sie unwiederbringlich aus dem Import-Wizard verschwinden zu lassen. Erscheint
// als eigene Übersicht oben auf /kosten; "Zuordnen" legt daraus eine echte Kostenposition an und
// löscht diese Zeile wieder (siehe ordneNichtZugeordneteBuchungZu in kosten/actions.ts).
model NichtZugeordneteBuchung {
  id               String       @id @default(cuid())
  datum            DateTime
  betrag           Decimal      @db.Decimal(10, 2)
  empfaenger       String?
  verwendungszweck String?
  // Sektion, in der der Nutzer beim Import "als nicht kategorisiert importieren" geklickt hat
  // (z.B. "Zahlungen", "Kosten") — rein informativ für die Übersicht, keine erzwungene Zuordnung.
  quelle           String?
  rohdaten         Json?
  importBatch      ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importBatchId    String?
  createdAt        DateTime     @default(now())

  @@index([datum, betrag])
  @@map("nicht_zugeordnete_buchungen")
}
